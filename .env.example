# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to set the Better Auth variables below.
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth — server-side auth (see src/lib/auth.ts).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (e.g. http://localhost:3000 in dev).
BETTER_AUTH_URL=
